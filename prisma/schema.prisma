generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum ReceivableType {
  PIUTANG // orang lain berhutang ke kita
  UTANG   // kita berhutang ke orang lain
}

model BankAccount {
  id           String        @id @default(cuid())
  name         String
  balance      Decimal       @default(0)
  transactions Transaction[] @relation("SourceAccount")
  transfersIn  Transaction[] @relation("DestinationAccount")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Transaction {
  id             String          @id @default(cuid())
  account        BankAccount     @relation("SourceAccount", fields: [accountId], references: [id], onDelete: Cascade)
  accountId      String
  toAccount      BankAccount?    @relation("DestinationAccount", fields: [toAccountId], references: [id], onDelete: SetNull)
  toAccountId    String?
  type           TransactionType
  category       String
  amount         Decimal
  date           DateTime
  note           String?
  affectsBalance Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) // dipelihara trigger DB, bukan Prisma

  @@index([updatedAt, id])
}

model DeletedTransaction {
  id        String   @id // id transaksi yang dihapus (cuid, tidak pernah dipakai ulang)
  deletedAt DateTime @default(now())

  @@index([deletedAt, id])
}

model Asset {
  id           String   @id @default(cuid())
  name         String
  category     String // properti, kendaraan, elektronik, dll
  value        Decimal
  acquiredDate DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Investment {
  id           String             @id @default(cuid())
  platform     String // Bibit, Ajaib, Indodax, dll
  name         String
  buyValue     Decimal
  currentValue Decimal
  entries      InvestmentEntry[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model InvestmentEntry {
  id           String     @id @default(cuid())
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  investmentId String
  month        DateTime // disimpan sebagai tanggal 1 di bulan tsb
  amount       Decimal // kontribusi/deposit bulan itu
}

model InvestmentYearlyTarget {
  id           String   @id @default(cuid())
  year         Int      @unique
  targetAmount Decimal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Receivable {
  id         String         @id @default(cuid())
  personName String
  amount     Decimal
  type       ReceivableType
  date       DateTime
  note       String?
  isSettled  Boolean        @default(false) // override manual, mis. dihapuskan/write-off
  payments   RepaymentEntry[]
  createdAt  DateTime       @default(now())
}

model RepaymentEntry {
  id           String     @id @default(cuid())
  receivable   Receivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  receivableId String
  date         DateTime
  amount       Decimal
  note         String?
  createdAt    DateTime   @default(now())
}

model BudgetCategory {
  id             String        @id @default(cuid())
  name           String        @unique
  monthlyPlanned Decimal       @default(0)
  entries        BudgetEntry[]
}

model BudgetEntry {
  id          String         @id @default(cuid())
  category    BudgetCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  String
  month       DateTime
  actual      Decimal        @default(0)
  expectation Decimal        @default(0)
  minTarget   Decimal?
  maxTarget   Decimal?

  @@unique([categoryId, month])
}

model CashflowForecast {
  id               String               @id @default(cuid())
  month            DateTime             @unique
  saldoAwal        Decimal              @default(0) // manual
  saldoAkhirActual Decimal? // manual, opsional (belum diisi = null)
  monthlyIncome    Decimal              @default(0) // gaji bulanan, manual
  budgetItems      CashflowBudgetItem[]
}

model CashflowBudgetItem {
  id         String           @id @default(cuid())
  forecast   CashflowForecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  forecastId String
  label      String // bebas teks: "Lifestyle", "Investasi", "Makan", dll
  amount     Decimal
  createdAt  DateTime         @default(now())
}

// Singleton: alokasi default (gaji + pos anggaran) yang dipakai sebagai nilai
// awal untuk bulan yang belum pernah dimaterialisasi (belum punya baris
// CashflowForecast sendiri). Begitu sebuah bulan disimpan, nilainya di-snapshot
// ke CashflowForecast/CashflowBudgetItem milik bulan itu dan lepas dari
// template — perubahan template selanjutnya tidak lagi memengaruhi bulan itu.
model CashflowAllocationTemplate {
  id            String                           @id @default(cuid())
  monthlyIncome Decimal                          @default(0)
  items         CashflowAllocationTemplateItem[]
  updatedAt     DateTime                         @updatedAt
}

model CashflowAllocationTemplateItem {
  id         String                     @id @default(cuid())
  template   CashflowAllocationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  templateId String
  label      String
  amount     Decimal
}

model SavingsGoal {
  id           String             @id @default(cuid())
  name         String // "Wedding", "Eid 2026", dll
  targetAmount Decimal // otomatis mengikuti total GoalItem jika sudah ada rincian
  tenorMonths  Int
  startDate    DateTime
  entries      SavingsGoalEntry[]
  items        GoalItem[]
  createdAt    DateTime           @default(now())
}

model SavingsGoalEntry {
  id          String      @id @default(cuid())
  goal        SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId      String
  month       DateTime
  amount      Decimal
  contributor String? // opsional: nama penabung, kosong = tidak dipecah per orang
}

enum GoalItemStatus {
  PLANNED
  BOOKED
  PAID
}

model GoalItem {
  id            String         @id @default(cuid())
  goal          SavingsGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  goalId        String
  category      String // "Mahar", "Catering", "THR", "Santunan", dll
  name          String // "Cincin", "Fotografer", nama individu, dll
  budgetAmount  Decimal
  actualAmount  Decimal?       @default(0)
  status        GoalItemStatus @default(PLANNED)
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}
